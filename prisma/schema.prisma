generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(cuid())
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  platformAdmin Boolean @default(false)
  demoOnly Boolean @default(false)
  mustChangePassword Boolean @default(true)
  locale String @default("ru")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  accounts Account[]
  memberships Membership[]
  @@map("users")
}
model Session {
  id String @id @default(cuid())
  token String @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("sessions")
}
model Account {
  id String @id @default(cuid())
  accountId String
  providerId String
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  password String?
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([providerId,accountId])
  @@map("accounts")
}
model Verification {
  id String @id @default(cuid())
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([identifier])
  @@map("verifications")
}
model RateLimit {
  id String @id @default(cuid())
  key String @unique
  count Int
  lastRequest BigInt
  @@map("rate_limits")
}
model Organization {
  competencyModels CompetencyModel[]
  sjtExpertKeys SjtExpertKey[]
  groupSchemes GroupScheme[]
  exercises AssessmentExercise[]
  id String @id @default(cuid())
  name String
  slug String @unique
  purpose String @default("assessment")
  dataMode String @default("real")
  status String @default("active")
  logoUrl String?
  color String @default("#25635f")
  employeeLimit Int @default(100)
  assessmentLimit Int @default(1000)
  showPreliminary Boolean @default(true)
  showApproved Boolean @default(true)
  aiBudget Float @default(25)
  retentionDays Int @default(1095)
  matrixConfig Json
  createdAt DateTime @default(now())
  memberships Membership[]
  units OrganizationUnit[]
  campaigns Campaign[]
  @@map("organizations")
}
model OrganizationUnit {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  name String
  @@unique([organizationId,name])
  @@unique([id,organizationId])
  @@map("organization_units")
}
model Membership {
  competencyConsensus CompetencyConsensus[]
  groupAssignments ParticipantGroup[]
  assignments TestAssignment[] @relation("AssignedParticipant")
  expertAssignments TestAssignment[] @relation("AssignedExpert")
  aiReports AiReport[]
  observations ExpertObservation[]
  reports FinalReport[]
  files FileAsset[]
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  role String @default("employee")
  position String @default("")
  profileRow Int?
  targetLevelModel String @default("В")
  block String?
  unit String @default("Головной офис")
  category String @default("Руководитель")
  status String @default("active")
  consentAt DateTime?
  consentVersion String?
  videoConsentVersion String?
  videoConsentAt DateTime?
  videoConsentLocale String?
  createdAt DateTime @default(now())
  @@unique([organizationId,userId])
  @@unique([id,organizationId])
  @@map("memberships")
}
model Campaign {
  country String?
  competencyConsensus CompetencyConsensus[]
  frozenNorm FrozenNorm?
  participantGroups ParticipantGroup[]
  generatedReports GeneratedReport[]
  aiReports AiReport[]
  observations ExpertObservation[]
  reports FinalReport[]
  files FileAsset[]
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  name String
  description String @default("")
  employerPermission Json?
  status String @default("active")
  startsAt DateTime @default(now())
  endsAt DateTime
  createdAt DateTime @default(now())
  assignments TestAssignment[]
  @@unique([id,organizationId])
  @@map("campaigns")
}
model Test {
  id String @id
  name Json
  description Json
  direction String
  source String
  licenseStatus String
  scientificBasis String
  versions TestVersion[]
  @@map("tests")
}
model TestVersion {
  id String @id @default(cuid())
  testId String
  test Test @relation(fields:[testId],references:[id])
  version String
  status String @default("draft")
  durationMinutes Int
  timeLimitSeconds Int?
  delivery Json @default("{}")
  instructions Json
  limitations Json
  translationStatus String @default("draft")
  approvedBy String?
  approvedAt DateTime?
  createdAt DateTime @default(now())
  questions Question[]
  keys ScoringKey[]
  assignments TestAssignment[]
  @@unique([testId,version])
  @@map("test_versions")
}
model Question {
  id String @id
  testVersionId String
  testVersion TestVersion @relation(fields:[testVersionId],references:[id])
  position Int
  type String
  text Json
  imageUrl String?
  content Json @default("{}")
  options AnswerOption[]
  @@unique([testVersionId,position])
  @@map("questions")
}
model AnswerOption {
  id String @id
  questionId String
  question Question @relation(fields:[questionId],references:[id])
  position Int
  text Json
  imageUrl String?
  @@map("answer_options")
}
model ScoringKey {
  id String @id @default(cuid())
  testVersionId String
  testVersion TestVersion @relation(fields:[testVersionId],references:[id])
  version String
  algorithm String
  config Json
  source String
  status String @default("preliminary")
  approvedBy String?
  approvedAt DateTime?
  controlExamples Json
  createdAt DateTime @default(now())
  @@unique([testVersionId,version])
  @@map("scoring_keys")
}
model TestAssignment {
  membership Membership @relation("AssignedParticipant",fields:[membershipId,organizationId],references:[id,organizationId])
  expert Membership? @relation("AssignedExpert",fields:[expertId,organizationId],references:[id,organizationId])
  id String @id @default(cuid())
  organizationId String
  campaignId String
  campaign Campaign @relation(fields:[campaignId,organizationId],references:[id,organizationId])
  membershipId String
  testVersionId String
  testVersion TestVersion @relation(fields:[testVersionId],references:[id])
  expertId String?
  assessorIds String[] @default([])
  createdAt DateTime @default(now())
  attempts TestAttempt[]
  @@unique([campaignId,membershipId,testVersionId])
  @@unique([id,organizationId])
  @@index([organizationId,membershipId])
  @@map("test_assignments")
}
model TestAttempt {
  videoSessions VideoSession[]
  id String @id @default(cuid())
  organizationId String
  assignmentId String
  assignment TestAssignment @relation(fields:[assignmentId,organizationId],references:[id,organizationId])
  attemptNumber Int @default(1)
  language String
  status String @default("in_progress")
  scoringKeyId String
  startedAt DateTime @default(now())
  submittedAt DateTime?
  expiresAt DateTime?
  timerStartedAt DateTime?
  lastHeartbeatAt DateTime?
  pausedAt DateTime?
  leftAt DateTime?
  departures Int @default(0)
  awayMs Int @default(0)
  extraSeconds Int @default(0)
  manuallySubmittedAt DateTime?
  answers UserAnswer[]
  results TestResult[]
  @@unique([assignmentId,attemptNumber])
  @@unique([id,organizationId])
  @@map("test_attempts")
}
model VideoSession {
  id String @id @default(uuid())
  attemptId String?
  attempt TestAttempt? @relation(fields:[attemptId], references:[id], onDelete:SetNull)
  organizationId String
  campaignId String
  membershipId String
  state String @default("connecting")
  egressId String? @unique
  createdAt DateTime @default(now())
  endedAt DateTime?
  expiresAt DateTime?
  @@index([organizationId,campaignId,createdAt])
  @@index([attemptId,state])
  @@index([state,expiresAt])
  @@map("video_sessions")
}
model UserAnswer {
  id String @id @default(cuid())
  organizationId String
  attemptId String
  attempt TestAttempt @relation(fields:[attemptId,organizationId],references:[id,organizationId])
  questionId String
  value Json
  revision Int @default(1)
  durationMs Int @default(0)
  answeredAt DateTime?
  receivedAt DateTime @default(now())
  delayed Boolean @default(false)
  updatedAt DateTime @updatedAt
  @@unique([attemptId,questionId])
  @@map("user_answers")
}
model TestResult {
  id String @id @default(cuid())
  organizationId String
  attemptId String
  attempt TestAttempt @relation(fields:[attemptId,organizationId],references:[id,organizationId])
  scoringKeyId String
  result Json
  reason String @default("initial")
  calculatedBy String?
  createdAt DateTime @default(now())
  @@unique([attemptId,scoringKeyId])
  @@map("test_results")
}
model AiReport {
  membership Membership @relation(fields:[membershipId,organizationId],references:[id,organizationId])
  campaign Campaign @relation(fields:[campaignId,organizationId],references:[id,organizationId])
  id String @id @default(cuid())
  prompt String @default("")
  providerConfig Json @default("{}")
  organizationId String
  campaignId String
  membershipId String
  status String @default("pending")
  model String
  promptVersion String
  inputHash String
  resultIds Json
  content Json?
  error String?
  promptTokens Int @default(0)
  completionTokens Int @default(0)
  cost Float @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organizationId,campaignId,membershipId])
  @@map("ai_reports")
}
model AssessmentExercise {
  organization Organization @relation(fields:[organizationId],references:[id])
  observations ExpertObservation[]
  @@unique([id,organizationId])
  id String @id @default(cuid())
  organizationId String
  type String
  name Json
  version Int @default(1)
  criteria Json
  active Boolean @default(true)
  createdAt DateTime @default(now())
  @@index([organizationId])
  @@map("assessment_exercises")
}
model ExpertObservation {
  membership Membership @relation(fields:[membershipId,organizationId],references:[id,organizationId])
  campaign Campaign @relation(fields:[campaignId,organizationId],references:[id,organizationId])
  exercise AssessmentExercise @relation(fields:[exerciseId,organizationId],references:[id,organizationId])
  id String @id @default(cuid())
  organizationId String
  campaignId String
  membershipId String
  expertId String
  exerciseId String
  criteriaSnapshot Json
  indicatorExamples Json @default("{}")
  scores Json
  notes String
  version Int
  createdAt DateTime @default(now())
  @@index([organizationId,campaignId,membershipId])
  @@map("expert_observations")
}
model FinalReport {
  membership Membership @relation(fields:[membershipId,organizationId],references:[id,organizationId])
  campaign Campaign @relation(fields:[campaignId,organizationId],references:[id,organizationId])
  id String @id @default(cuid())
  organizationId String
  campaignId String
  membershipId String
  authorId String
  version Int
  status String @default("draft")
  content Json
  resultIds Json
  observationIds Json
  aiReportId String?
  matrixX Int?
  matrixY Int?
  matrixReason String?
  approvedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([organizationId,campaignId,membershipId,version])
  @@index([organizationId,campaignId])
  @@map("final_reports")
}
model GeneratedReport {
  policyVersion String @default("legacy")
  reviewIssues Json @default("[]")
  presentationEdits Json @default("{}")
  artifact ReportArtifact?
  assessmentCompletedAt DateTime?
  readyAt DateTime?
  generationMode String @default("ai")
  id String @id @default(cuid())
  organizationId String
  campaignId String
  campaign Campaign @relation(fields:[campaignId,organizationId],references:[id,organizationId],onDelete:Cascade)
  membershipId String?
  kind String
  language String
  status String @default("pending")
  participantIds Json
  snapshot Json
  inputHash String
  content Json?
  model String
  prompt String
  promptVersion String
  providerConfig Json
  error String?
  cost Float @default(0)
  promptTokens Int @default(0)
  completionTokens Int @default(0)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organizationId,campaignId,kind])
  @@map("generated_reports")
}
model ReportArtifact {
  reportId String @id
  report GeneratedReport @relation(fields:[reportId],references:[id],onDelete:Cascade)
  bytes Bytes
  sha256 String
  createdAt DateTime @default(now())
  @@map("report_artifacts")
}
model FrozenNorm {
  id String @id @default(cuid())
  organizationId String
  campaignId String @unique
  campaign Campaign @relation(fields:[campaignId,organizationId],references:[id,organizationId],onDelete:Cascade)
  expectedCount Int @default(65)
  excludedCount Int
  metrics Json
  sourceHash String
  createdBy String
  createdAt DateTime @default(now())
  @@unique([campaignId,organizationId])
  @@map("frozen_norms")
}
model SjtExpertKey {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  version Int
  status String @default("draft")
  payload Json
  authorId String
  createdAt DateTime @default(now())
  @@unique([organizationId,version])
  @@map("sjt_expert_keys")
}
model GroupScheme {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  version Int
  status String @default("draft")
  content Json
  authorId String
  createdAt DateTime @default(now())
  assignments ParticipantGroup[]
  @@unique([organizationId,version])
  @@unique([id,organizationId])
  @@map("group_schemes")
}
model ParticipantGroup {
  id String @id @default(cuid())
  organizationId String
  campaignId String
  campaign Campaign @relation(fields:[campaignId,organizationId],references:[id,organizationId],onDelete:Cascade)
  membershipId String
  membership Membership @relation(fields:[membershipId,organizationId],references:[id,organizationId],onDelete:Cascade)
  schemeId String
  scheme GroupScheme @relation(fields:[schemeId,organizationId],references:[id,organizationId],onDelete:Cascade)
  groupId String
  reason String
  consensusId String
  authorId String
  createdAt DateTime @default(now())
  @@index([organizationId,campaignId,membershipId,createdAt])
  @@map("participant_groups")
}
model CompetencyModel {
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade,onUpdate:NoAction)
  consensus CompetencyConsensus[] @relation("TenantCompetencyConsensus")
  legacyConsensus CompetencyConsensus[] @relation("LegacyCompetencyConsensus")
  @@unique([id,organizationId])
  id String @id @default(cuid())
  organizationId String
  version Int
  status String @default("draft")
  content Json
  authorId String
  approvedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([organizationId,version])
  @@index([organizationId],map:"competency_models_org")
  @@map("competency_models")
}
model CompetencyConsensus {
  membership Membership @relation(fields:[membershipId,organizationId],references:[id,organizationId],onDelete:Cascade,onUpdate:NoAction)
  campaign Campaign @relation(fields:[campaignId,organizationId],references:[id,organizationId],onDelete:Cascade,onUpdate:NoAction)
  model CompetencyModel @relation("TenantCompetencyConsensus",fields:[modelId,organizationId],references:[id,organizationId],onDelete:Cascade,onUpdate:Cascade)
  legacyModel CompetencyModel @relation("LegacyCompetencyConsensus",fields:[modelId],references:[id],onDelete:NoAction,onUpdate:NoAction,map:"competency_consensus_modelId_fkey")
  id String @id @default(cuid())
  organizationId String
  campaignId String
  membershipId String
  modelId String
  version Int
  scores Json
  authorId String
  createdAt DateTime @default(now())
  @@unique([organizationId,campaignId,membershipId,version],map:"competency_consensus_organizationId_campaignId_membershipId_key")
  @@map("competency_consensus")
}
model LicenseRecord {
  id String @id @default(cuid())
  testId String
  source String
  status String
  notes String
  recordedAt DateTime @default(now())
  @@map("license_records")
}
model AuditLog {
  id String @id @default(cuid())
  organizationId String?
  actorId String?
  action String
  entityId String?
  detail Json?
  createdAt DateTime @default(now())
  @@index([organizationId,createdAt])
  @@map("audit_logs")
}
model FileAsset {
  membership Membership @relation(fields:[membershipId,organizationId],references:[id,organizationId])
  campaign Campaign @relation(fields:[campaignId,organizationId],references:[id,organizationId])
  id String @id @default(cuid())
  organizationId String
  campaignId String
  membershipId String
  uploadedBy String
  name String
  contentType String
  size Int
  storageKey String @unique
  createdAt DateTime @default(now())
  @@index([organizationId,membershipId])
  @@map("file_assets")
}
model PlatformSettings {
  id String @id @default("default")
  aiModel String @default("")
  encryptedApiKey String?
  aiPrompt String
  aiPromptVersion String @default("2.0")
  aiProviderAllowlist Json
  aiZdr Boolean @default(true)
  updatedAt DateTime @updatedAt
  @@map("platform_settings")
}
