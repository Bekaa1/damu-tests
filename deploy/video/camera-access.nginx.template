worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr crit;
events { worker_connections 4096; }

http {
    access_log off;
    log_format credential_status '$time_iso8601 $status $upstream_status';
    server_tokens off;
    client_body_temp_path /tmp/client;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    resolver 127.0.0.11 valid=10s ipv6=off;

    server {
        listen 8080;
        location ~ "^/api/(attempts/[A-Za-z0-9_-]+/camera|video/[A-Za-z0-9_-]+/watch)$" {
            limit_except POST { deny all; }
            access_log /tmp/credential-status.log credential_status;
            set $backend ${CAMERA_API_UPSTREAM};
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Accept-Encoding "";
            proxy_set_header Host $http_host;
            proxy_pass http://$backend$request_uri;
            sub_filter_types application/json;
            sub_filter '"wss://${VIDEO_HOST}"' '"wss://${APP_DOMAIN}/camera-signal"';
        }
        location / { return 404; }
    }
}
